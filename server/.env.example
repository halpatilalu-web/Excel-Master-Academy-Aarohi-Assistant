# Copy to server/.env and fill only the sections you use.
# Never commit a real server/.env.

# --- Core server -------------------------------------------------------------
BACKEND_PORT=8000
# APP_DB_PATH=/absolute/path/to/data.db
# APP_SEED_PATH=/absolute/path/to/seed.json
# Extra origins allowed to send cookie-authenticated writes, comma separated
# (only needed when the SPA is served from a different host than the API).
# APP_ALLOWED_ORIGINS=https://excel.example.com

# --- Aarohi online AI (optional) --------------------------------------------
# Any OpenAI-compatible chat-completions provider. Leave LLM_API_KEY empty to
# use the built-in offline Excel knowledge base (or Orvis AI when configured).
# The endpoint is rate limited per user, per IP and globally (server/assistant.py).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Orvis platform services (optional) --------------------------------------
# Only needed for server/services/* features such as Google login, storage,
# payments, email or Orvis AI/images. Values are normally provisioned for the app.
# See docs/optional-services.md before enabling any of these.
ORVIS_API_URL=
ORVIS_PUBLIC_API_URL=
ORVIS_APP_ID=
ORVIS_SECRET_KEY=
ORVIS_SERVICES=

# --- Payments (only with the Orvis `payments` service) -----------------------
# Amount in paise/cents. When set, the browser's amount is IGNORED and this is
# charged — use it unless you look prices up server-side yourself.
# PAYMENTS_SERVER_PRICE_MINOR=49900

# --- Demo login (disabled by default) ----------------------------------------
DEMO_ENABLED=0
DEMO_EMAIL=demo@example.com
# Required when DEMO_ENABLED=1; use a strong, unique password (8+ characters).
DEMO_PASSWORD=
