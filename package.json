{
  "name": "excel-master-live",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "python scripts/run_server.py --reload",
    "dev:all": "concurrently -k -n web,api -c blue,green \"pnpm dev\" \"pnpm dev:server\"",
    "typecheck": "tsc -b",
    "test:data": "python scripts/check_data.py",
    "test:server": "python scripts/run_tests.py",
    "test:web": "vitest run",
    "test": "pnpm test:data && pnpm test:web && pnpm test:server",
    "build": "tsc -b && vite build",
    "start": "python scripts/run_server.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.469.0",
    "motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.20.0"
}
